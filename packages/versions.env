# Versões mínimas para CLIs instalados via brew/scoop.
# Carregado pelos 3 scripts de bootstrap (linux.sh, macos.sh, windows.ps1).
# Os scripts instalam a versão mais recente do package manager e então abortam
# se o binário final ficar abaixo do mínimo declarado aqui.
#
# Formato estrito: KEY=VALUE, sem aspas, sem espaços ao redor do =.
# Comentários com # no início da linha. Versões em formato semver (MAJOR.MINOR.PATCH).
#
# Para exigir um mínimo novo, simplesmente edite o valor — nenhum código de gate
# muda.

NVIM_MIN_VERSION=0.12.0
NU_MIN_VERSION=0.92.0
