#!/usr/bin/env bash
# Provisions the user's Neovim config by cloning github.com/bgarciamoura/neovim
# into ~/.config/nvim. Runs after chezmoi applies and any time this script's
# hash changes. Idempotent: skips when the target is already a working copy of
# that repo; otherwise backs up any pre-existing directory before cloning.
#
# Counterpart: .chezmoiscripts/run_onchange_after_20-clone-nvim.ps1.tmpl runs on
# Windows. Both are guarded by .chezmoiignore so only the right one is applied.
set -euo pipefail

{{/* hash-src: v1 — bump to force rerun after bugfixes */ -}}
# hash: v1

log()  { printf "\033[1;34m[chezmoi]\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[chezmoi]\033[0m %s\n" "$*" >&2; }

# Skip on Windows — counterpart .ps1 handles it there.
{{- if eq .chezmoi.os "windows" }}
exit 0
{{- end }}

NVIM_DIR="$HOME/.config/nvim"
NVIM_REPO="https://github.com/bgarciamoura/neovim"
REPO_MATCH="bgarciamoura/neovim"

if ! command -v git >/dev/null 2>&1; then
    warn "git not on PATH; cannot provision Neovim config. Install git and rerun 'chezmoi apply'."
    exit 0
fi

if [ -d "$NVIM_DIR/.git" ]; then
    current_url=$(git -C "$NVIM_DIR" remote get-url origin 2>/dev/null || true)
    if [[ "$current_url" == *"$REPO_MATCH"* ]]; then
        log "Neovim config already cloned at $NVIM_DIR — skipping."
        exit 0
    fi
fi

if [ -e "$NVIM_DIR" ]; then
    backup="${NVIM_DIR}.bak-$(date +%Y%m%d-%H%M%S)"
    log "Existing $NVIM_DIR is not our repo — moving to $backup"
    mv "$NVIM_DIR" "$backup"
fi

mkdir -p "$(dirname "$NVIM_DIR")"
log "Cloning $NVIM_REPO into $NVIM_DIR"
git clone "$NVIM_REPO" "$NVIM_DIR"

DEPS_SCRIPT="$NVIM_DIR/scripts/install-deps.sh"
if [ -f "$DEPS_SCRIPT" ]; then
    chmod +x "$DEPS_SCRIPT" 2>/dev/null || true
    log "Running $DEPS_SCRIPT"
    if ! bash "$DEPS_SCRIPT"; then
        warn "install-deps.sh exited non-zero — inspect output above."
    fi
else
    log "scripts/install-deps.sh not present in repo — skipping deps step."
fi

log "Neovim config ready at $NVIM_DIR"
