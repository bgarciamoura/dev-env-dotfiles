// Zellij config (managed by chezmoi).
// See https://zellij.dev/documentation/configuration.html

default_shell "nu"
default_layout "compact"

// Inherit WezTerm's font and theme; use compact UI.
pane_frames false
simplified_ui false
mouse_mode true
// Without copy_command, Zellij copies through OSC 52 (handled by the terminal).
{{- if eq .chezmoi.os "darwin" }}
copy_command "pbcopy"
{{- end }}

scroll_buffer_size 20000

// Theme name matches a file in ~/.config/zellij/themes ({name}.kdl), Zellij's
// default theme directory. Do not set theme_dir to a "~" path: it isn't expanded.
// Palette defined under dotfiles/.chezmoidata/themes.toml and applied via chezmoi.
theme "{{ .theme }}"

// Load plugin aliases
load_plugins {
    tab-bar
    status-bar
}

// Keybindings — sane defaults with vim-style pane navigation in normal mode.
keybinds {
    normal {
        bind "Ctrl g" { SwitchToMode "Locked"; }
        bind "Alt h" { MoveFocusOrTab "Left"; }
        bind "Alt l" { MoveFocusOrTab "Right"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt n" { NewPane; }
        bind "Alt t" { NewTab; }
        bind "Alt g" { Run "lazygit" { floating true; close_on_exit true; }; }
    }
}
