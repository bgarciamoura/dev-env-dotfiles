# env.nu — evaluated before config.nu. Sets environment and PATH.
# Managed by chezmoi. Edit in the source repo, not here.

# --- PATH ---------------------------------------------------------------
# Start from existing PATH, then prepend user-local bins.
$env.PATH = ($env.PATH | split row (char esep))

def --env prepend-path [p: string] {
    if ($p | path exists) and (not ($env.PATH | any {|it| $it == $p})) {
        $env.PATH = ($env.PATH | prepend $p)
    }
}

prepend-path ($nu.home-dir | path join ".local/bin")
prepend-path ($nu.home-dir | path join ".cargo/bin")
prepend-path ($nu.home-dir | path join "go/bin")

{{- if eq .chezmoi.os "darwin" }}
prepend-path "/opt/homebrew/bin"
prepend-path "/opt/homebrew/sbin"
prepend-path "/usr/local/bin"
{{- end }}

{{- if eq .chezmoi.os "linux" }}
prepend-path "/home/linuxbrew/.linuxbrew/bin"
prepend-path "/home/linuxbrew/.linuxbrew/sbin"
prepend-path "/snap/bin"
prepend-path ($nu.home-dir | path join "platform-tools")
{{- end }}

{{- if eq .chezmoi.os "windows" }}
prepend-path ($nu.home-dir | path join "scoop" "shims")
prepend-path ($nu.home-dir | path join "AppData" "Roaming" "Cargo" "bin")
{{- end }}

# --- Editor & pager -----------------------------------------------------
$env.EDITOR = "nvim"
$env.VISUAL = "nvim"
$env.PAGER  = "bat --style=plain --paging=always"

# --- XDG (Windows compatibility) ---------------------------------------
$env.XDG_CONFIG_HOME = ($nu.home-dir | path join ".config")
$env.XDG_DATA_HOME   = ($nu.home-dir | path join ".local" "share")
$env.XDG_CACHE_HOME  = ($nu.home-dir | path join ".cache")

# --- Starship prompt cache ---------------------------------------------
$env.STARSHIP_SHELL  = "nu"
$env.STARSHIP_CONFIG = ($env.XDG_CONFIG_HOME | path join "starship.toml")

# --- Carapace completions ----------------------------------------------
$env.CARAPACE_BRIDGES = "zsh,fish,bash,inshellisense"

# --- ADB on WSL2 --------------------------------------------------------
# Point the WSL client at the Windows-side adb server (USB lives in Windows).
# Assumes networkingMode=mirrored, where localhost reaches Windows. In NAT mode
# use the default gateway instead; in mirrored mode that is the LAN router.
{{- if eq .chezmoi.os "linux" }}
if ($env | get -o WSL_DISTRO_NAME | is-not-empty) {
    $env.ADB_SERVER_SOCKET = "tcp:127.0.0.1:5037"
}
{{- end }}

# --- Generate vendor autoload files (starship, zoxide, atuin, carapace) -
# These are regenerated here so they track the installed binary versions.
# Must be written to $nu.data-dir, not default-config-dir: nushell only
# auto-loads files from $nu.vendor-autoload-dirs, which is rooted at
# $XDG_DATA_HOME/nushell (e.g. ~/.local/share/nushell/vendor/autoload).
# Saving under .config/nushell/ leaves them on disk but never loaded.
let vendor_dir = ($nu.data-dir | path join "vendor" "autoload")
mkdir $vendor_dir

if (which starship | is-not-empty) {
    starship init nu | save -f ($vendor_dir | path join "starship.nu")
}
if (which zoxide | is-not-empty) {
    zoxide init nushell | save -f ($vendor_dir | path join "zoxide.nu")
}
if (which atuin | is-not-empty) {
    atuin init nu --disable-up-arrow | save -f ($vendor_dir | path join "atuin.nu")
}
if (which carapace | is-not-empty) {
    carapace _carapace nushell | save -f ($vendor_dir | path join "carapace.nu")
}
if (which mise | is-not-empty) {
    mise activate nu | save -f ($vendor_dir | path join "mise.nu")
}
