{{- $t := index .themes .theme -}}
local M = {}

function M.apply(config)
	config.colors = {
		foreground    = "{{ $t.fg }}",
		background    = "{{ $t.bg }}",
		cursor_bg     = "{{ $t.cursor }}",
		cursor_border = "{{ $t.cursor }}",
		cursor_fg     = "{{ $t.bg }}",
		selection_bg  = "{{ $t.selection }}",
		selection_fg  = "{{ $t.fg }}",
		ansi = {
			"{{ $t.black }}",
			"{{ $t.red }}",
			"{{ $t.green }}",
			"{{ $t.yellow }}",
			"{{ $t.blue }}",
			"{{ $t.purple }}",
			"{{ $t.cyan }}",
			"{{ $t.white }}",
		},
		brights = {
			"{{ $t.bright_black }}",
			"{{ $t.bright_red }}",
			"{{ $t.bright_green }}",
			"{{ $t.bright_yellow }}",
			"{{ $t.bright_blue }}",
			"{{ $t.bright_purple }}",
			"{{ $t.bright_cyan }}",
			"{{ $t.bright_white }}",
		},
		tab_bar = {
			background = "{{ $t.tab_bar_bg }}",
			active_tab = {
				bg_color = "{{ $t.tab_active_bg }}",
				fg_color = "{{ $t.tab_active_fg }}",
			},
			inactive_tab = {
				bg_color = "{{ $t.tab_inactive_bg }}",
				fg_color = "{{ $t.tab_inactive_fg }}",
			},
			inactive_tab_hover = {
				bg_color = "{{ $t.tab_inactive_bg }}",
				fg_color = "{{ $t.bright_yellow }}",
			},
			new_tab = {
				bg_color = "{{ $t.bright_yellow }}",
				fg_color = "{{ $t.bg }}",
			},
			new_tab_hover = {
				bg_color = "{{ $t.bright_red }}",
				fg_color = "{{ $t.bg }}",
			},
		},
	}

	config.window_background_opacity = 0.98
	config.window_decorations = "RESIZE"
	config.window_padding = { left = 8, right = 8, top = 6, bottom = 6 }

	config.use_fancy_tab_bar = false
	config.hide_tab_bar_if_only_one_tab = false
	config.tab_max_width = 32

	config.scrollback_lines = 20000
	config.enable_scroll_bar = false

	config.audible_bell = "Disabled"
	config.exit_behavior = "Close"
	config.automatically_reload_config = true

	config.default_cursor_style = "BlinkingBlock"
	config.cursor_blink_rate = 400
	config.cursor_blink_ease_in = { CubicBezier = { 0.42, 0.0, 1.0, 1.0 } }
	config.cursor_blink_ease_out = { CubicBezier = { 0.0, 0.0, 0.58, 1.0 } }
end

return M
